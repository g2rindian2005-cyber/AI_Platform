# ===== SERVER =====
PORT=5000
NODE_ENV=production

# ===== FRONTEND URL (for CORS) - CHANGE THIS to your EC2 public IP/domain =====
FRONTEND_URL=http://localhost:5173

# ===== POSTGRESQL DATABASE - CHANGE THESE =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devopsai
DB_USER=devopsai_user
DB_PASSWORD=change_this_password

# ===== JWT - CHANGE THIS SECRET (use: openssl rand -base64 48) =====
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ===== AI PROVIDER (OpenAI-compatible) =====
# Used for: question generation, answer evaluation, AI assistant chat.
# Get a key from https://platform.openai.com/api-keys (or any OpenAI-compatible provider)
# If left empty, the app falls back to a basic offline scoring/response mode.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
